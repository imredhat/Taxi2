# The service key is separate from the map display key.
EXPO_PUBLIC_NESHAN_MAP_KEY=web.REPLACE_WITH_YOUR_WEB_SDK_KEY
# Set this to an HTTPS origin permitted by the map key's domain restrictions.
EXPO_PUBLIC_NESHAN_MAP_BASE_URL=https://localhost/
# Passenger application API URL. Android devices need the server's LAN address or HTTPS host.
EXPO_PUBLIC_API_URL=http://localhost:3001

EXPO_PUBLIC_NESHAN_SERVICE_KEY=
