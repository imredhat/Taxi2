# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taxi2
DB_USER=postgres
DB_PASSWORD=

# Server Configuration
PORT=3000
NODE_ENV=development

# IPPanel SMS Gateway
IPPANEL_API_KEY=
IPPANEL_SENDER=+983000505

# SEP / Saman payment gateway (server only; leave empty until the merchant terminal is ready)
SEP_TERMINAL_ID=
# Local checkout simulation. Set false to use the live Saman gateway.
SEP_SANDBOX=false
PUBLIC_API_URL=
# Set JWT_SECRET to a deployment-specific secret; never expose it to the passenger app.

# Fare quoting (server-side routing, reverse geocoding and optional forecast provider)
NESHAN_SERVICE_KEY=
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
WEATHER_FORECAST_KEY=


# Redis 6.2+ for the dispatch basket and live updates. Use a private, authenticated endpoint.
# DISPATCH_REDIS_URL=redis://127.0.0.1:6379
# Explicit browser origins in production. Native clients authenticate with a bearer JWT.
# DISPATCH_WEB_ORIGINS=https://driver.example.com,https://passenger.example.com

# Firebase service-account JSON path for Android chat push. Keep the file outside source control.
# FCM_SERVICE_ACCOUNT_FILE=
